    {
      "label": "Thesis: Convert annotations (stage 1 + 2)",
      "type": "shell",
      "command": "python scripts/convert_annotations.py --stage1 data/annotations/stage1_export.json --stage2 data/annotations/stage2_export.json",
      "problemMatcher": []
    },
    {
      "label": "Thesis: Run evaluation (regex only)",
      "type": "shell",
      "command": "python scripts/evaluate.py",
      "problemMatcher": []
    },
    {
      "label": "Thesis: Compute ANLS*",
      "type": "shell",
      "command": "python scripts/compute_anls.py",
      "problemMatcher": []
